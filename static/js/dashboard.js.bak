let importData = null;
let currentImportDest = 'cj6mt';
let currentTab = new URLSearchParams(window.location.search).get('tab') || 'performance';
let globalData = null;
let chartInstance = null;
let perfFilterMode = 'all';
let showSniperRaw = false;
let missingBuysData = null;

function fmtISK(val) {
  if (!val && val !== 0) return '0 ISK';
  if (Math.abs(val) >= 1e9) return (val / 1e9).toFixed(2) + 'B ISK';
  if (Math.abs(val) >= 1e6) return (val / 1e6).toFixed(1) + 'M ISK';
  return Math.round(val).toLocaleString() + ' ISK';
}

// Universal clipboard helper (works on localhost, HTTPS, and remote LAN HTTP)
async function copyToClipboard(text) {
  if (navigator.clipboard && window.isSecureContext) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (err) {
      console.warn('navigator.clipboard failed, attempting fallback', err);
    }
  }

  try {
    const textArea = document.createElement('textarea');
    textArea.value = text;
    textArea.style.position = 'fixed';
    textArea.style.left = '-999999px';
    textArea.style.top = '-999999px';
    textArea.setAttribute('readonly', '');
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    const successful = document.execCommand('copy');
    textArea.remove();
    return successful;
  } catch (err) {
    console.error('Remote LAN copy fallback failed:', err);
    return false;
  }
}

let isFetchingState = false;
let lastStateSignature = '';
let lastChartSignature = '';

function computeStateSignature(d) {
  if (!d) return '';
  const m = d.metrics || {};
  const c = d.character || {};
  const st = d.status || {};
  const deskRows = d.desks?.[currentTab] || [];
  const firstRow = deskRows[0] || {};
  const lastRow = deskRows[deskRows.length - 1] || {};
  return [
    c.orders_count,
    c.total_escrow,
    c.ledger_coverage,
    m.total_capital,
    m.total_profit,
    m.liquid_reserve,
    st.sniper_running,
    st.ledger_running,
    st.last_ledger_run,
    d.sniper?.timestamp,
    (d.sniper?.deals || []).length,
    deskRows.length,
    firstRow.live_ask,
    firstRow.action_text,
    lastRow.live_ask,
    lastRow.action_text,
    d.performance?.kpis?.net_profit_30d
  ].join('|');
}

async function fetchData(forceRender = false) {
  if (isFetchingState) return;
  isFetchingState = true;
  try {
    const res = await fetch('/api/state');
    if (!res.ok) {
      console.error('Failed to fetch /api/state: HTTP', res.status);
      return;
    }
    const nextData = await res.json();
    const sig = computeStateSignature(nextData);
    globalData = nextData;
    if (forceRender || sig !== lastStateSignature) {
      lastStateSignature = sig;
      renderMetrics();
      renderActiveTab();
    }
  } catch (err) {
    console.error('FetchData error:', err);
  } finally {
    isFetchingState = false;
  }
}

function renderMetrics() {
  if (!globalData) return;
  const m = globalData.metrics;
  const c = globalData.character;
  
  document.getElementById('m-cap').innerText = fmtISK(m.total_capital);
  document.getElementById('m-prof').innerText = '+' + fmtISK(m.total_profit);
  document.getElementById('m-roi').innerText = m.blended_roi.toFixed(1) + '%';
  document.getElementById('m-res').innerText = fmtISK(m.liquid_reserve);
  document.getElementById('m-coverage').innerText = c.ledger_coverage;
  document.getElementById('m-orders-count').innerText = c.orders_count + ' orders';
  document.getElementById('m-escrow').innerText = 'Escrow: ' + fmtISK(c.total_escrow);
  if (document.getElementById('m-budget')) {
    document.getElementById('m-budget').innerText = 'Budget: ' + fmtISK(m.portfolio_budget || m.total_capital);
  }
  // Update tab labels dynamically with actual desk capital
  if (globalData.desk_metrics) {
    const egCap = globalData.desk_metrics.evergreen?.cap;
    const tacCap = globalData.desk_metrics.tactical?.cap;
    const hldCap = globalData.desk_metrics.hold?.cap;
    if (egCap !== undefined && document.getElementById('tab-evergreen')) {
      document.getElementById('tab-evergreen').innerText = `Evergreen (${fmtISK(egCap)})`;
    }
    if (tacCap !== undefined && document.getElementById('tab-tactical')) {
      document.getElementById('tab-tactical').innerText = `Tactical (${fmtISK(tacCap)})`;
    }
    if (hldCap !== undefined && document.getElementById('tab-hold')) {
      document.getElementById('tab-hold').innerText = `Hold (${fmtISK(hldCap)})`;
    }
  }

  if (document.getElementById('tag-eg-budget') && globalData.desk_metrics?.evergreen) {
    document.getElementById('tag-eg-budget').innerText = fmtISK(globalData.desk_metrics.evergreen.cap) + ' Allocated';
  }
  if (document.getElementById('tag-tac-budget') && globalData.desk_metrics?.tactical) {
    document.getElementById('tag-tac-budget').innerText = fmtISK(globalData.desk_metrics.tactical.cap) + ' Allocated';
  }
  if (document.getElementById('tag-hld-budget') && globalData.desk_metrics?.hold) {
    document.getElementById('tag-hld-budget').innerText = fmtISK(globalData.desk_metrics.hold.cap) + ' Allocated';
  }

  document.getElementById('sniper-time').innerText = 'Last scan: ' + (globalData.sniper.timestamp || 'Never');
  document.getElementById('last-ledger-time').innerText = 'Last Ledger: ' + (globalData.status.last_ledger_run || 'Never');

  document.getElementById('spinner-snipe').classList.toggle('hidden', !globalData.status.sniper_running);
  document.getElementById('text-snipe').innerText = globalData.status.sniper_running ? 'Scanning...' : 'Run Deal Sniper';
  document.getElementById('spinner-ledger').classList.toggle('hidden', !globalData.status.ledger_running);
  document.getElementById('text-ledger').innerText = globalData.status.ledger_running ? 'Generating...' : 'Rebuild Auto';

  const sso = document.getElementById('sso-auth-container');
  if (c.is_linked) {
    sso.innerHTML = `
      <div class="flex items-center gap-2 bg-emerald-950/60 border border-emerald-600/60 px-3 py-1.5 rounded text-xs font-mono text-emerald-300">
        <img class="w-6 h-6 rounded-full border border-emerald-400" src="https://images.evetech.net/characters/${c.character_id}/portrait?size=64" />
        <span>${c.name}</span>
        <button onclick="triggerEsiSync()" class="ml-1 text-slate-400 hover:text-white" title="Refresh ESI">↻</button>
      </div>`;
  }
}

function switchTab(tab) {
  currentTab = tab;
  ['performance', 'sniper', 'evergreen', 'tactical', 'hold', 'imports', 'guide'].forEach(t => {
    const btn = document.getElementById('tab-' + t);
    if (!btn) return;
    if (t === tab) {
      btn.className = `px-4 py-2 border-b-2 ${t === 'performance' ? 'border-evePink text-evePink' : 'border-eveCyan text-eveCyan'} font-semibold text-sm transition`;
    } else {
      btn.className = 'px-4 py-2 border-b-2 border-transparent text-slate-400 hover:text-slate-200 font-semibold text-sm transition';
    }
  });
  renderActiveTab();
}

function setPerfFilter(mode) {
  perfFilterMode = mode;
  ['all', 'winners', 'losers'].forEach(m => {
    const btn = document.getElementById('btn-perf-' + m);
    if (m === mode) {
      btn.className = 'px-3 py-1 rounded bg-evePink text-white font-semibold transition';
    } else {
      btn.className = 'px-3 py-1 rounded text-slate-400 hover:text-white transition';
    }
  });
  renderPerformanceTable();
}

function toggleSniperRaw() {
  showSniperRaw = !showSniperRaw;
  document.getElementById('sniper-raw-wrapper').classList.toggle('hidden', !showSniperRaw);
  document.getElementById('btn-toggle-raw').innerText = showSniperRaw ? 'Hide Console Log' : 'Show Console Log';
}

function renderActiveTab() {
  if (!globalData) return;
  const panels = ['performance', 'sniper', 'table', 'imports', 'guide'];
  panels.forEach(p => {
    const el = document.getElementById('panel-' + p);
    if (el) el.classList.add('hidden');
  });

  document.getElementById('sniper-controls').classList.add('hidden');
  if (document.getElementById('imports-controls')) document.getElementById('imports-controls').classList.add('hidden');
  document.getElementById('table-filters').classList.add('hidden');

  if (currentTab === 'performance') {
    document.getElementById('panel-performance').classList.remove('hidden');
    renderPerformance(globalData.performance);
  } else if (currentTab === 'sniper') {
    document.getElementById('panel-sniper').classList.remove('hidden');
    document.getElementById('sniper-controls').classList.remove('hidden');
    renderSniperTable(globalData.sniper.deals || []);
    document.getElementById('sniper-output').innerText = globalData.sniper.raw_output || 'No scans recorded.';
  } else if (currentTab === 'imports') {
    document.getElementById('panel-imports').classList.remove('hidden');
    if (document.getElementById('imports-controls')) document.getElementById('imports-controls').classList.remove('hidden');
    if (!importData) {
      loadImportOpportunities(false);
    } else {
      renderImportsTab();
    }
  } else if (currentTab === 'guide') {
    document.getElementById('panel-guide').classList.remove('hidden');
  } else {
    document.getElementById('panel-table').classList.remove('hidden');
    document.getElementById('table-filters').classList.remove('hidden');

    const allDeskRows = globalData.desks[currentTab] || [];
    const deskCap = allDeskRows.reduce((sum, r) => sum + (parseFloat(r.capital) || 0), 0);
    const deskProf = allDeskRows.reduce((sum, r) => sum + (parseFloat(r.profit) || 0), 0);
    const deskRoi = deskCap > 0 ? (deskProf / deskCap * 100) : 0;

    const unplacedRows = allDeskRows.filter(r => r.char_status === 'UNPLACED');
    const buyActiveRows = allDeskRows.filter(r => r.char_status === 'BUY_ACTIVE');
    const deskNeeded = unplacedRows.reduce((sum, r) => sum + (parseFloat(r.capital) || 0), 0);
    const deskEscrow = buyActiveRows.reduce((sum, r) => sum + (parseFloat(r.escrow) || parseFloat(r.capital) || 0), 0);

    const elCap = document.getElementById('ds-cap');
    const elProf = document.getElementById('ds-prof');
    const elRoi = document.getElementById('ds-roi');
    const elLbl = document.getElementById('ds-label');
    const elEscrow = document.getElementById('ds-escrow');
    const elNeeded = document.getElementById('ds-needed');
    const elUnplacedBadge = document.getElementById('ds-unplaced-badge');

    if (elCap) elCap.innerText = fmtISK(deskCap);
    if (elProf) elProf.innerText = '+' + fmtISK(deskProf);
    if (elRoi) elRoi.innerText = deskRoi.toFixed(1) + '%';
    if (elLbl) elLbl.innerText = `${currentTab.toUpperCase()} DESK`;
    if (elEscrow) elEscrow.innerText = fmtISK(deskEscrow);
    if (elNeeded) elNeeded.innerText = fmtISK(deskNeeded);
    if (elUnplacedBadge) elUnplacedBadge.innerText = `${unplacedRows.length} unplaced`;

    let rows = allDeskRows;
    if (document.getElementById('filter-unplaced') && document.getElementById('filter-unplaced').checked) {
      rows = rows.filter(r => r.char_status === 'UNPLACED');
    }
    if (document.getElementById('filter-cancel') && document.getElementById('filter-cancel').checked) {
      rows = rows.filter(r => (r.action_code || '').startsWith('CANCEL_'));
    }
    renderTableRows(rows);
  }
}

function renderPerformance(perf) {
  if (!perf) return;
  const k = perf.kpis;
  document.getElementById('perf-net').innerText = fmtISK(k.net_profit_30d);
  document.getElementById('perf-net-sub').innerText = fmtISK(k.net_profit_30d);
  document.getElementById('perf-income').innerText = fmtISK(k.trade_income_30d);
  document.getElementById('perf-purchases').innerText = '-' + fmtISK(k.trade_purchases_30d);
  document.getElementById('perf-margin').innerText = k.blended_margin.toFixed(1) + '%';
  renderChart(perf.chart);
  renderPerformanceTable();
}

function renderPerformanceTable() {
  if (!globalData?.performance?.items) return;
  const threshold = parseFloat(document.getElementById('perf-min-threshold').value) || 5000000;
  let items = globalData.performance.items.filter(it => Math.abs(it.profit) >= threshold);

  if (perfFilterMode === 'winners') items = items.filter(it => it.profit > 0).sort((a, b) => (a.name || a.type_name || "").localeCompare(b.name || b.type_name || ""));
  else if (perfFilterMode === 'losers') items = items.filter(it => it.profit < 0).sort((a,b) => a.profit - b.profit);
  else items.sort((a, b) => (a.name || a.type_name || "").localeCompare(b.name || b.type_name || ""));

  document.getElementById('perf-item-count').innerText = `${items.length} items (≥ ${fmtISK(threshold)})`;
  const tbody = document.getElementById('perf-table-body');
  if (!items.length) {
    tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-500">No items match criteria.</td></tr>`;
    return;
  }

  tbody.innerHTML = items.map((it, i) => {
    const isP = it.profit >= 0;
    return `
      <tr class="hover:bg-slate-800/40 transition">
        <td class="p-3 text-slate-500">${i + 1}</td>
        <td class="p-3 font-semibold text-white">
          <a href="https://evetycoon.com/market/${it.type_id}" target="_blank" rel="noopener noreferrer" class="hover:text-eveCyan hover:underline inline-flex items-center gap-1.5 transition">
            <span>${it.name}</span>
            <svg class="w-3 h-3 text-slate-500 inline shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </td>
        <td class="p-3 text-right text-slate-300 font-semibold">${it.qty_sold.toLocaleString()}</td>
        <td class="p-3 text-right text-slate-300">${fmtISK(it.revenue)}</td>
        <td class="p-3 text-right text-slate-400">${fmtISK(it.cost)}</td>
        <td class="p-3 text-right ${isP ? 'text-eveGreen font-bold' : 'text-eveRed font-bold'}">${isP ? '+' : '-'}${fmtISK(Math.abs(it.profit))}</td>
        <td class="p-3 text-right ${isP ? 'text-eveCyan' : 'text-eveRed'} font-semibold">${it.revenue > 0 ? (it.profit / it.revenue * 100).toFixed(1) : 0}%</td>
      </tr>`;
  }).join('');
}

function renderChart(chartData) {
  const ctx = document.getElementById('dailyProfitsChart').getContext('2d');
  const chartSig = JSON.stringify([chartData.labels, chartData.running_totals, chartData.daily_profits]);
  if (chartInstance) {
    if (chartSig === lastChartSignature) return;
    lastChartSignature = chartSig;
    chartInstance.data.labels = chartData.labels;
    chartInstance.data.datasets[0].data = chartData.running_totals;
    chartInstance.data.datasets[1].data = chartData.daily_profits;
    chartInstance.data.datasets[1].backgroundColor = chartData.daily_profits.map(v => v >= 0 ? '#ec4899' : '#ef4444');
    chartInstance.update('none');
    return;
  }
  lastChartSignature = chartSig;

  chartInstance = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: chartData.labels,
      datasets: [
        {
          type: 'line',
          label: '30d Running Total',
          data: chartData.running_totals,
          borderColor: '#94a3b8',
          backgroundColor: 'rgba(148, 163, 184, 0.1)',
          borderWidth: 2,
          pointRadius: 0,
          yAxisID: 'yRunning',
          tension: 0.2,
          fill: true
        },
        {
          type: 'bar',
          label: 'Daily Profit',
          data: chartData.daily_profits,
          backgroundColor: chartData.daily_profits.map(v => v >= 0 ? '#ec4899' : '#ef4444'),
          borderRadius: 3,
          yAxisID: 'yDaily'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      devicePixelRatio: Math.min(window.devicePixelRatio || 1, 1.5),
      animation: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${fmtISK(ctx.parsed.y)}` } }
      },
      scales: {
        x: { grid: { color: '#1e293b' }, ticks: { color: '#64748b', font: { family: 'monospace', size: 10 } } },
        yDaily: { position: 'left', grid: { color: '#1e293b' }, ticks: { color: '#ec4899', font: { family: 'monospace', size: 10 }, callback: v => fmtISK(v) } },
        yRunning: { position: 'right', grid: { display: false }, ticks: { color: '#94a3b8', font: { family: 'monospace', size: 10 }, callback: v => fmtISK(v) } }
      }
    }
  });
}

function renderSniperTable(deals) {
  const tbody = document.getElementById('sniper-table-body');
  if (!tbody) return;
  const countEl = document.getElementById('sniper-deal-count');
  if (countEl) countEl.innerText = `${deals ? deals.length : 0} deals detected`;

  if (!deals || !deals.length) {
    tbody.innerHTML = '<tr><td colspan="10" class="p-6 text-center text-slate-500">No active firesales detected. Click "Run Deal Sniper" above to trigger a fresh scan.</td></tr>';
    return;
  }

  tbody.innerHTML = deals.map((d, i) => {
    const name = d.name || d.item_name || 'Unknown Item';
    const typeId = d.type_id || '';
    const qty = d.qty || d.quantity || 1;
    const discount = Math.abs(d.discount_pct || 0).toFixed(1);
    const askPrice = d.ask_price || 0;
    const targetExit = d.target_exit || d.target_sell || 0;
    const netMargin = (d.net_margin || 0).toFixed(1);
    const capital = d.capital || d.total_cost || 0;
    const profit = d.profit || d.est_profit || 0;
    const isFiresale = d.deal_type && d.deal_type.includes('FIRESALE');

    return `
    <tr class="hover:bg-slate-800/40 transition">
      <td class="p-3 text-slate-500">${i + 1}</td>
      <td class="p-3"><span class="${isFiresale ? 'bg-amber-950/70 text-amber-300 border-amber-600/80' : 'bg-cyan-950/70 text-cyan-300 border-cyan-600/80'} border px-2 py-0.5 rounded text-[10px] font-bold">${d.deal_type || 'DEAL'}</span></td>
      <td class="p-3 font-semibold text-white"><a href="https://evetycoon.com/market/${typeId}" target="_blank" class="hover:text-eveCyan hover:underline">${name}</a></td>
      <td class="p-3 text-right text-slate-300">${qty}</td>
      <td class="p-3 text-right text-amber-400 font-semibold">-${discount}%</td>
      <td class="p-3 text-right text-slate-200 font-semibold">${fmtISK(askPrice)}</td>
      <td class="p-3 text-right text-slate-300">${fmtISK(targetExit)}</td>
      <td class="p-3 text-right text-eveCyan font-bold">${netMargin}%</td>
      <td class="p-3 text-right text-slate-300 font-semibold">${fmtISK(capital)}</td>
      <td class="p-3 text-right text-eveGreen font-bold">+${fmtISK(profit)}</td>
    </tr>`;
  }).join('');
}

function renderTableRows(rows) {
  const tbody = document.getElementById('table-body');
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="13" class="p-4 text-center text-slate-500">No matching items.</td></tr>';
    return;
  }

  tbody.innerHTML = rows.map((r, i) => {
    let badge = r.char_status === 'BUY_ACTIVE' 
      ? `<span class="bg-blue-900/60 text-blue-300 border border-blue-700/80 px-1.5 py-0.5 rounded text-[10px] font-bold">BUY ACTIVE</span>`
      : r.char_status === 'SELL_ACTIVE' 
      ? `<span class="bg-emerald-900/60 text-emerald-300 border border-emerald-700/80 px-1.5 py-0.5 rounded text-[10px] font-bold">SELL LISTED</span>`
      : `<span class="bg-slate-800 text-slate-400 border border-slate-700 px-1.5 py-0.5 rounded text-[10px]">UNPLACED</span>`;
    let deskActionBadge = '<span class="text-slate-600 font-mono text-[10px]">--</span>';
    if (r.action_code === 'TOP_BOOK') {
      deskActionBadge = `<span class="bg-emerald-950/80 text-emerald-300 border border-emerald-600/80 px-2 py-0.5 rounded text-[10px] font-bold tracking-wider inline-flex items-center gap-1 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>TOP BID</span>
      </span>`;
    } else if (r.action_code === 'PRIME_DIP') {

      deskActionBadge = `<span class="bg-amber-950/90 text-amber-300 border border-amber-500/90 px-2 py-0.5 rounded text-[10px] font-bold tracking-wider inline-flex items-center gap-1 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        <span>★ PRIME DIP</span>
      </span>`;
    } else if (r.action_code === 'BUMP_VIABLE') {
      deskActionBadge = `<span class="bg-cyan-950/90 text-cyan-300 border border-cyan-500/90 px-2 py-0.5 rounded text-[10px] font-bold tracking-wider inline-flex items-center gap-1 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
        <span>${r.action_text || 'BUMP VIABLE'}</span>
      </span>`;
    } else if ((r.action_code || '').startsWith('CANCEL_')) {
      deskActionBadge = `<span class="bg-rose-950/90 text-rose-300 border border-rose-600/90 px-2 py-0.5 rounded text-[10px] font-bold tracking-wider inline-flex items-center gap-1 font-mono" title="Top bid exceeds profitable threshold. Cancel order to free escrow for active rotation.">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
        <span>${r.action_text || 'CANCEL (CEILING)'}</span>
      </span>`;
    } else if (r.action_code === 'PATIENT') {
      deskActionBadge = `<span class="bg-slate-800/80 text-slate-300 border border-slate-700 px-2 py-0.5 rounded text-[10px] font-mono">
        ${r.action_text || 'HOLD FIRM'}
      </span>`;
    } else if (r.action_code === 'SELL_ACTIVE') {
      deskActionBadge = `<span class="text-emerald-400 font-mono text-[10px]">SELLING</span>`;
    } else if (r.action_code === 'UNPLACED') {
      deskActionBadge = `<span class="text-amber-500 font-mono text-[10px]">NEW ORDER</span>`;
    }


    let proxBadge = '<span class="text-slate-600 font-mono">--</span>';
    let liveAskStr = r.live_ask
      ? fmtISK(r.live_ask)
      : (r.ask_polled
          ? "<span class=\"text-amber-400 font-bold text-[10px] bg-amber-950/70 border border-amber-800 px-1 py-0.5 rounded\">OUT OF STOCK</span>"
          : "<span class=\"text-slate-400 font-mono text-[10px] bg-slate-800/80 border border-slate-700 px-1.5 py-0.5 rounded\">UNPOLLED</span>");

    if (r.proximity_pct !== null && r.proximity_pct !== undefined) {
      const p = r.proximity_pct;
      const diff = r.diff_pct;
      const diffSign = diff >= 0 ? '+' : '';

      if (p >= 99.9) {
        proxBadge = `
          <span class="bg-emerald-950/80 text-emerald-300 border border-emerald-600/80 px-2 py-0.5 rounded text-[10px] font-bold tracking-wider inline-flex items-center gap-1 font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>TARGET MET 100.0%</span>
          </span>`;
      } else if (p >= 85) {
        proxBadge = `
          <span class="bg-cyan-950/80 text-cyan-300 border border-cyan-600/80 px-2 py-0.5 rounded text-[10px] font-bold tracking-wider inline-flex items-center gap-1 font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>${p.toFixed(1)}% (${diffSign}${diff.toFixed(1)}%)</span>
          </span>`;
      } else {
        proxBadge = `
          <span class="bg-amber-950/90 text-amber-300 border border-amber-600/80 px-2 py-0.5 rounded text-[10px] font-bold tracking-wider inline-flex items-center gap-1 font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>DEEP DIP ${p.toFixed(1)}% (${diffSign}${diff.toFixed(1)}%)</span>
          </span>`;
      }
    }

    const isProf = (r.profit || 0) >= 0;
    return `
      <tr class="hover:bg-slate-800/40 transition">
        <td class="p-3 text-slate-500">${i + 1}</td>
        <td class="p-3">${badge}</td>
        <td class="p-3 text-center">${deskActionBadge}</td>
        <td class="p-3 font-semibold text-white"><a href="https://evetycoon.com/market/${r.type_id}" target="_blank" class="hover:text-eveCyan hover:underline">${r.name}</a></td>
        <td class="p-3 text-right text-slate-300">${r.qty}</td>
        <td class="p-3 text-right text-slate-400">${r.dump_freq.toFixed(1)}%</td>
        <td class="p-3 text-right text-slate-200">${fmtISK(r.target_buy)}</td>
        <td class="p-3 text-right text-slate-200 font-semibold">${fmtISK(r.target_sell)}</td>
        <td class="p-3 text-right text-slate-300 font-mono">${liveAskStr}</td>
        <td class="p-3 text-center">${proxBadge}</td>
        <td class="p-3 text-right ${isProf ? 'text-eveCyan font-semibold' : 'text-red-400 font-bold'}">${r.net_margin.toFixed(1)}%</td>
        <td class="p-3 text-right">
          ${r.char_status === 'UNPLACED'
            ? `<div class="font-mono font-bold text-amber-300">${fmtISK(r.capital)}</div><div class="text-[9px] text-amber-500 font-bold uppercase tracking-wider">Needed</div>`
            : r.char_status === 'BUY_ACTIVE'
            ? `<div class="font-mono font-bold text-blue-300">${fmtISK(r.escrow || r.capital)}</div><div class="text-[9px] text-blue-500 font-bold uppercase tracking-wider">In Escrow</div>`
            : `<div class="font-mono font-semibold text-slate-300">${fmtISK(r.capital)}</div><div class="text-[9px] text-emerald-500 font-semibold uppercase tracking-wider">Sell Listed</div>`
          }
        </td>
        <td class="p-3 text-right ${isProf ? 'text-eveGreen font-bold' : 'text-red-400 font-bold'}">${isProf ? '+' : ''}${fmtISK(r.profit)}</td>
      </tr>`;
  }).join('');
}

async function triggerSniper() {
  // Immediately switch view to the Deal Sniper tab
  if (typeof switchTab === 'function') {
    switchTab('sniper');
  }

  // Set scanning indicators
  const spinner = document.getElementById('spinner-snipe');
  const text = document.getElementById('text-snipe');
  if (spinner) spinner.classList.remove('hidden');
  if (text) text.innerText = 'Scanning...';

  try {
    await fetch('/api/sniper/run', { method: 'POST' });
  } catch (e) {
    console.error('Failed to trigger deal sniper:', e);
  }
}

let askPollingActive = false;

async function triggerAskRefresh() {
  const spinner = document.getElementById('spinner-asks');
  const text = document.getElementById('text-asks');
  askPollingActive = true;
  spinner.classList.remove('hidden');
  text.innerText = 'Polling Books...';
  try {
    await fetch('/api/market/refresh-prices', { method: 'POST' });
    setTimeout(fetchData, 4500);
    setTimeout(fetchData, 9000);
  } finally {
    setTimeout(() => {
      askPollingActive = false;
      spinner.classList.add('hidden');
      text.innerText = 'Poll Asks';
    }, 9500);
  }
}

async function triggerEsiSync() { await fetch('/api/orders/sync-esi', { method: 'POST' }); fetchData(); }
async function triggerLedgers() { await fetch('/api/ledgers/run', { method: 'POST' }); fetchData(); }

async function openMissingBuysModal() {
  const btn = document.getElementById('btn-missing-buys');
  const spinner = document.getElementById('spinner-missing');
  const btnText = document.getElementById('text-missing');
  
  spinner.classList.remove('hidden');
  btnText.innerText = 'Checking ESI Books...';
  btn.disabled = true;

  try {
    const deskParam = ['evergreen', 'tactical', 'hold'].includes(currentTab) ? currentTab : 'all';
    const res = await fetch(`/api/orders/missing-buys?desk=${deskParam}`);
    if (!res.ok) {
      throw new Error(`Server returned HTTP ${res.status}`);
    }
    missingBuysData = await res.json();

    if (!missingBuysData.items || !missingBuysData.items.length) {
      alert('All buy orders for this desk are already active and tracked in ESI!');
      return;
    }

    // Safely copy using LAN-compatible fallback
    if (missingBuysData.multibuy_text) {
      await copyToClipboard(missingBuysData.multibuy_text);
    }

    document.getElementById('modal-missing-count').innerText = `${missingBuysData.total_items} items`;
    document.getElementById('modal-missing-escrow').innerText = fmtISK(missingBuysData.total_escrow);
    
    const tbody = document.getElementById('modal-missing-body');
    tbody.innerHTML = missingBuysData.items.map((it, i) => `
      <tr class="hover:bg-slate-800/40 transition">
        <td class="p-2.5 text-slate-500">${i + 1}</td>
        <td class="p-2.5 font-semibold text-white">
          <a href="https://evetycoon.com/market/${it.type_id}" target="_blank" class="hover:text-eveCyan hover:underline">${it.name}</a>
          ${it.squeezed ? '<span class="ml-1 text-[9px] bg-red-950 text-red-400 border border-red-800 px-1 py-0.2 rounded font-bold">MARGIN CAP</span>' : ''}
        </td>
        <td class="p-2.5 text-right text-slate-300 font-semibold">${it.qty.toLocaleString()}</td>
        <td class="p-2.5 text-right text-slate-400 font-mono">${fmtISK(it.top_buy)}</td>
        <td class="p-2.5 text-right text-eveCyan font-bold font-mono">${fmtISK(it.recommended_buy)}</td>
        <td class="p-2.5 text-right text-eveGreen font-semibold">${it.margin_pct}%</td>
        <td class="p-2.5 text-right text-slate-300 font-mono">${fmtISK(it.line_escrow)}</td>
        <td class="p-2.5 text-center">
          <button onclick="copySinglePrice(${it.recommended_buy}, this)" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 px-2 py-0.5 rounded text-[10px] font-mono transition">
            Copy
          </button>
        </td>
      </tr>
    `).join('');

    document.getElementById('modal-missing').classList.remove('hidden');
  } catch (err) {
    console.error('Missing buys error:', err);
    alert('Failed to audit live ESI market books: ' + err.message);
  } finally {
    spinner.classList.add('hidden');
    btnText.innerText = 'Missing Buy Orders';
    btn.disabled = false;
  }
}

function closeMissingBuysModal() {
  document.getElementById('modal-missing').classList.add('hidden');
}

async function copyMultibuyText(btn) {
  if (missingBuysData && missingBuysData.multibuy_text) {
    const success = await copyToClipboard(missingBuysData.multibuy_text);
    const orig = btn.innerText;
    btn.innerText = success ? 'Copied to Clipboard!' : 'Copy Failed';
    setTimeout(() => { btn.innerText = orig; }, 2000);
  }
}

async function copySinglePrice(price, btn) {
  const success = await copyToClipboard(price.toString());
  const orig = btn.innerText;
  btn.innerText = success ? 'Copied!' : 'Failed';
  if (success) btn.classList.add('text-eveGreen', 'border-emerald-600');
  setTimeout(() => {
    btn.innerText = orig;
    btn.classList.remove('text-eveGreen', 'border-emerald-600');
  }, 1200);
}

// Fast 3s poll only while a background job runs; 60s when idle; paused in hidden tabs
setInterval(() => {
  if (document.hidden) return;
  const busy = askPollingActive || globalData?.status?.sniper_running || globalData?.status?.ledger_running;
  if (busy) fetchData();
}, 3000);

setInterval(() => {
  if (!document.hidden) fetchData();
}, 60000);

document.addEventListener('visibilitychange', () => {
  if (!document.hidden) fetchData();
});

fetchData();

// ==========================================
// UNIFIED MULTISELL & INVENTORY ADVISOR
// ==========================================
let advisorData = null;
let currentAdvisorFilter = 'all';

async function openInventoryAdvisor(customText = null, forceRefresh = false) {
  const modal = document.getElementById('advisor-modal');
  if (!modal) return;
  modal.classList.remove('hidden');

  const tbody = document.getElementById('advisor-table-body');
  tbody.innerHTML = '<tr><td colspan="8" class="text-center py-8 text-slate-400 font-sans"><div class="inline-block animate-spin mr-2">⟳</div> Scanning inventory, live Jita books & cost basis...</td></tr>';

  try {
    let res;
    if (customText && customText.trim()) {
      res = await fetch('/api/inventory/advisor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ raw_text: customText })
      });
    } else {
      const url = forceRefresh ? '/api/inventory/advisor?force=true' : '/api/inventory/advisor'; res = await fetch(url);
    }
    if (!res.ok) throw new Error('API returned status ' + res.status);
    advisorData = await res.json();
    renderAdvisorView();
  } catch (err) {
    tbody.innerHTML = `<tr><td colspan="8" class="text-center py-8 text-rose-400 font-sans">Error loading inventory: ${err.message}</td></tr>`;
  }
}

window.openMultiSellModal = () => openInventoryAdvisor();
window.openMultisell = () => openInventoryAdvisor();

function closeInventoryAdvisor() {
  const modal = document.getElementById('advisor-modal');
  if (modal) modal.classList.add('hidden');
}

function toggleCustomPasteDrawer() {
  const drawer = document.getElementById('custom-paste-drawer');
  if (drawer) drawer.classList.toggle('hidden');
}

function submitCustomPaste() {
  const textarea = document.getElementById('adv-custom-paste-text');
  if (!textarea || !textarea.value.trim()) return;
  openInventoryAdvisor(textarea.value.trim());
}

function reloadHangarAssets() {
  const textarea = document.getElementById('adv-custom-paste-text');
  if (textarea) textarea.value = '';
  const drawer = document.getElementById('custom-paste-drawer');
  if (drawer) drawer.classList.add('hidden');
  openInventoryAdvisor(null, true);
}

function filterAdvisor(filterType) {
  currentAdvisorFilter = filterType;
  ['all', 'ready', 'hold', 'unmanaged'].forEach(t => {
    const btn = document.getElementById(`tab-adv-${t}`);
    if (btn) {
      if (t === filterType) {
        btn.className = "px-2.5 py-1 rounded font-semibold bg-slate-800 text-slate-200 transition";
      } else {
        btn.className = "px-2.5 py-1 rounded font-semibold text-slate-400 hover:text-slate-200 transition";
      }
    }
  });
  renderAdvisorTable();
}

function renderAdvisorView() {
  if (!advisorData) return;

  const totalCount = advisorData.items ? advisorData.items.length : 0;
  const readyItems = (advisorData.items || []).filter(i => ['flip', 'met', 'unmanaged', 'time_stop'].includes(i.action_type));

  const totalValEl = document.getElementById('adv-total-val');
  if (totalValEl) totalValEl.textContent = fmtISK(advisorData.total_value);

  const totalCountEl = document.getElementById('adv-total-count');
  if (totalCountEl) totalCountEl.textContent = `${totalCount} items evaluated`;

  const costValEl = document.getElementById('adv-cost-val');
  if (costValEl) costValEl.textContent = fmtISK(advisorData.total_cost);

  const pCard = document.getElementById('adv-profit-card');
  const pVal = document.getElementById('adv-profit-val');
  const mVal = document.getElementById('adv-margin-val');
  const isProfit = (advisorData.total_profit || 0) >= 0;

  if (pVal) pVal.textContent = (isProfit ? '+' : '') + fmtISK(advisorData.total_profit);
  const blendedMargin = advisorData.total_cost > 0 ? (advisorData.total_profit / advisorData.total_cost * 100).toFixed(1) : '0.0';
  if (mVal) mVal.textContent = `${isProfit ? '+' : ''}${blendedMargin}% net return`;

  if (pCard && pVal && mVal) {
    if (isProfit) {
      pCard.className = "bg-emerald-950/20 border border-emerald-800/40 rounded-lg p-3";
      pVal.className = "text-base font-bold text-emerald-300 mt-0.5";
      mVal.className = "text-[11px] text-emerald-400/80";
    } else {
      pCard.className = "bg-rose-950/20 border border-rose-800/40 rounded-lg p-3";
      pVal.className = "text-base font-bold text-rose-300 mt-0.5";
      mVal.className = "text-[11px] text-rose-400/80";
    }
  }

  const readyValEl = document.getElementById('adv-ready-val');
  if (readyValEl) readyValEl.textContent = fmtISK(advisorData.ready_value);

  const readyCountEl = document.getElementById('adv-ready-count');
  if (readyCountEl) readyCountEl.textContent = `${readyItems.length} items ready to list`;

  renderAdvisorTable();
}

function renderAdvisorTable() {
  if (!advisorData) return;
  const tbody = document.getElementById('advisor-table-body');
  if (!tbody) return;

  let rows = advisorData.items || [];
  if (currentAdvisorFilter === 'ready') {
    rows = rows.filter(i => ['flip', 'met', 'unmanaged', 'time_stop'].includes(i.action_type));
  } else if (currentAdvisorFilter === 'hold') {
    rows = rows.filter(i => i.action_type === 'hold');
  } else   if (currentAdvisorFilter === 'unmanaged') {
    rows = rows.filter(i => i.desk === 'UNMANAGED');
  }

  // Sort alphabetically by item type name (A to Z)
  rows.sort((a, b) => (a.name || "").localeCompare(b.name || ""));

  if (rows.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-8 text-slate-500 font-sans">No loose items matching this filter. (Items inside containers or other regions are ignored)</td></tr>';
    return;
  }

  let html = '';
  rows.forEach(item => {
    let deskBadge = '<span class="text-slate-400 font-semibold text-[10px] bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700">UNMANAGED</span>';
    if (item.desk === 'EVERGREEN') {
      deskBadge = '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-cyan-950/70 text-cyan-300 border border-cyan-800">EVERGREEN</span>';
    } else if (item.desk === 'TACTICAL') {
      deskBadge = '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-950/70 text-purple-300 border border-purple-800">TACTICAL</span>';
    } else if (item.desk === 'HOLD') {
      deskBadge = '<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-950/70 text-amber-300 border border-amber-800">HOLD</span>';
    }

    let actionBadge = '';
    if (item.collision && item.collision.has_collision) {
      const c = item.collision;
      const cStyle = c.action === 'CANCEL_MERGE' ? 'bg-amber-950/80 text-amber-300 border border-amber-500/80' :
                     c.action === 'HOLD_HANGAR' ? 'bg-rose-950/80 text-rose-300 border border-rose-500/80' :
                     c.action === 'MODIFY_HOLD' ? 'bg-cyan-950/80 text-cyan-300 border border-cyan-500/80' :
                     'bg-emerald-950/80 text-emerald-300 border border-emerald-500/80';
      actionBadge = `<span class="px-2 py-0.5 rounded font-bold text-[10px] ${cStyle}" title="${c.reason}">${c.badge}</span>`;
    } else if (item.action_type === 'flip') {
      actionBadge = '<span class="px-2 py-0.5 rounded font-bold text-[10px] bg-emerald-950/80 border border-emerald-700 text-emerald-300">FAST FLIP</span>';
    } else if (item.action_type === 'met') {
      actionBadge = '<span class="px-2 py-0.5 rounded font-bold text-[10px] bg-blue-950/80 border border-blue-700 text-blue-300">TARGET MET</span>';
    } else if (item.action_type === 'time_stop') {
      const hd = item.hold_data || {};
      const reason = `Holding period exceeded: held ${hd.days_held || 0}d (max ${hd.max_days || 60}d). Liquidating at market ask to recycle stagnant capital.`;
      actionBadge = `<span class="px-2 py-0.5 rounded font-bold text-[10px] bg-rose-950/80 border border-rose-600 text-rose-300" title="${reason}">⏰ TIME STOP (${hd.days_held || 0}d)</span>`;
    } else if (item.action_type === 'hold') {
      const hd = item.hold_data || {};
      const holdSuffix = hd.days_held ? ` (${hd.days_held}d/${hd.max_days || 60}d)` : '';
      actionBadge = `<span class="px-2 py-0.5 rounded font-bold text-[10px] bg-amber-950/80 border border-amber-700 text-amber-300" title="Target sell not yet met${holdSuffix}">HOLD CYCLE${hd.days_held ? ` (${hd.days_held}d)` : ''}</span>`;
    } else {
      actionBadge = '<span class="px-2 py-0.5 rounded font-bold text-[10px] bg-indigo-950/80 border border-indigo-700 text-indigo-300">MARKET EXIT</span>';
    }

    let costDisplay = '<span class="text-slate-500 font-sans">--</span>';
    if (item.unit_cost > 0) {
      let tagColor = item.cost_source === 'WALLET' ? 'text-cyan-400' : (item.cost_source === 'LEDGER' ? 'text-amber-400' : 'text-slate-400');
      costDisplay = `<div>${fmtISK(item.unit_cost)}</div><div class="text-[9px] ${tagColor}">${item.cost_source}</div>`;
    }

    let plDisplay = '';
    if (item.cost_source === 'UNKNOWN') {
      plDisplay = `<span class="text-slate-400 font-bold">+${fmtISK(item.profit)}</span><div class="text-[9px] text-slate-500">Gross Proceeds</div>`;
    } else if (item.profit >= 0) {
      plDisplay = `<span class="text-emerald-400 font-bold">+${fmtISK(item.profit)}</span><div class="text-[9px] text-emerald-500/80 font-bold">+${item.margin_pct}%</div>`;
    } else {
      plDisplay = `<span class="text-rose-400 font-bold">${fmtISK(item.profit)}</span><div class="text-[9px] text-rose-500/80 font-bold">${item.margin_pct}%</div>`;
    }

    const liveAskStr = item.lowest_ask ? fmtISK(item.lowest_ask) : '<span class="text-amber-500 font-sans font-bold text-[10px]">STOCKOUT</span>';

    html += `
      <tr class="hover:bg-slate-800/40 transition">
        <td class="py-2.5 px-3 text-slate-200 font-medium font-sans">
          ${item.collision && item.collision.has_collision ? `
            <span class="inline-block mr-1.5 px-1 rounded text-[9px] font-bold ${
              item.collision.action === 'CANCEL_MERGE' ? 'bg-amber-950 text-amber-300 border border-amber-500/60' :
              item.collision.action === 'HOLD_HANGAR' ? 'bg-rose-950 text-rose-300 border border-rose-500/60' :
              item.collision.action === 'MODIFY_HOLD' ? 'bg-cyan-950 text-cyan-300 border border-cyan-500/60' :
              'bg-emerald-950 text-emerald-300 border border-emerald-500/60'
            }" title="${item.collision.reason}">COLLISION</span>
          ` : ''}${item.name}
        </td>
        <td class="py-2.5 px-2">${deskBadge}</td>
        <td class="py-2.5 px-2 text-right text-slate-300">${item.qty}</td>
        <td class="py-2.5 px-2 text-right font-sans">${costDisplay}</td>
        <td class="py-2.5 px-2 text-right text-slate-300">${liveAskStr}</td>
        <td class="py-2.5 px-2 text-right font-bold text-slate-100">${fmtISK(item.recommended_sell)}</td>
        <td class="py-2.5 px-3 text-right font-sans">${plDisplay}</td>
        <td class="py-2.5 px-3 text-center">${actionBadge}</td>
      </tr>
    `;
  });

  tbody.innerHTML = html;
}

async function copyAdvisorMultisell(type) {
  if (!advisorData || !advisorData.items) return;
  let items = [...advisorData.items];
  if (type === 'ready') {
    items = items.filter(i => ['flip', 'met', 'unmanaged', 'time_stop'].includes(i.action_type));
  }
  items.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
  const text = items.map(i => `${i.name}\t${Number(i.recommended_sell).toFixed(2)}`).join('\n');

  if (!text.trim()) {
    alert('No sell export data available to copy.');
    return;
  }
  const success = await copyToClipboard(text);
  if (success) {
    alert(`Copied ${type === 'ready' ? 'Ready-to-Sell' : 'All Strategy'} items (${items.length}) in EVE MultiSell format!`);
  } else {
    prompt("Clipboard blocked by browser. Press Ctrl+C to copy:", text);
  }
}

// ==========================================
// CROSS-REGION IMPORTS (JITA -> AMARR / C-J6MT)
// ==========================================
async function loadImportOpportunities(force = false) {
  const spinner = document.getElementById('spinner-imports');
  const btnText = document.getElementById('text-imports');
  const btn = document.getElementById('btn-scan-imports');
  const tbody = document.getElementById('imports-table-body');

  if (spinner) spinner.classList.remove('hidden');
  if (btnText) btnText.innerText = force ? 'Scanning Books...' : 'Loading...';
  if (btn) btn.disabled = true;

  if (tbody && (!importData || force)) {
    tbody.innerHTML = '<tr><td colspan="11" class="p-6 text-center text-slate-400">Scanning Jita 4-4, Amarr VIII & C-J6MT structure books...</td></tr>';
  }

  try {
    const amarrWarps = parseInt(document.getElementById('imp-amarr-warps')?.value || '35', 10);
    const cj6mtRate = parseFloat(document.getElementById('imp-cj6mt-rate')?.value) || 800;
    const url = `/api/import/opportunities?amarr_warps=${amarrWarps}&cj6mt_rate=${cj6mtRate}&force=${force}`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    importData = await res.json();
    renderImportsTab();
  } catch (err) {
    console.error('Import scan failed:', err);
    if (tbody) {
      tbody.innerHTML = `<tr><td colspan="11" class="p-6 text-center text-rose-400">Failed to load import opportunities: ${err.message}</td></tr>`;
    }
  } finally {
    if (spinner) spinner.classList.add('hidden');
    if (btnText) btnText.innerText = 'Scan Live Books';
    if (btn) btn.disabled = false;
  }
}

function setImportDest(destKey) {
  currentImportDest = destKey;
  const btnCj = document.getElementById('btn-imp-cj6mt');
  const btnAm = document.getElementById('btn-imp-amarr');
  if (btnCj && btnAm) {
    btnCj.className = destKey === 'cj6mt'
      ? 'px-3.5 py-1.5 rounded text-xs font-bold bg-eveCyan/20 text-eveCyan border border-eveCyan/50 transition'
      : 'px-3.5 py-1.5 rounded text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700 hover:text-slate-200 transition';
    btnAm.className = destKey === 'amarr'
      ? 'px-3.5 py-1.5 rounded text-xs font-bold bg-eveAmber/20 text-eveAmber border border-eveAmber/50 transition'
      : 'px-3.5 py-1.5 rounded text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700 hover:text-slate-200 transition';
  }
  renderImportsTab();
}

function renderImportsTab() {
  if (!importData) return;
  const sec = importData[currentImportDest];
  const tbody = document.getElementById('imports-table-body');
  if (!sec || !tbody) return;

  const setTxt = (id, txt) => { const el = document.getElementById(id); if (el) el.innerText = txt; };
  const isCj = currentImportDest === 'cj6mt';
  setTxt('imp-scan-time', 'Last scan: ' + (importData.timestamp || '--'));
  setTxt('imp-batch-m3', Math.round(Number(sec.multibuy_m3) || 0).toLocaleString() + ' m³');
  const allJitaBuy = (sec.items || []).reduce((acc, r) => acc + ((Number(r.jita_ask) || 0) * (Number(r.suggested_qty) || 0)), 0);
  setTxt('imp-batch-col', fmtISK(Number(sec.multibuy_collateral) || 0));
  setTxt('imp-all-buy', fmtISK(allJitaBuy));
  setTxt('imp-batch-freight', fmtISK(Number(sec.multibuy_freight) || 0));
  setTxt('imp-batch-profit', '+' + fmtISK(Number(sec.multibuy_profit) || 0));
  setTxt('imp-item-count', `${sec.count || 0} items`);
  const sellerTag = (isCj && sec.character_name) ? ` [Seller: ${sec.character_name}]` : '';
  setTxt('imp-table-title', isCj
    ? `Jita 4-4 → C-J6MT (1st Taj Mahgoon) Import Opportunities${sellerTag}`
    : 'Jita 4-4 → Amarr VIII (Oris) Import Opportunities');
  const switchBtn = document.getElementById('btn-switch-cj6mt-char');
  if (switchBtn && importData.cj6mt?.character_name) {
    switchBtn.innerText = `C-J6MT Seller: ${importData.cj6mt.character_name} (Switch)`;
  }

  const freightEl = document.getElementById('imp-batch-freight');
  if (sec.pricing_model === 'hisec_tiered') {
    const splitNote = sec.split_plan_top20 ? ` | Top-100 Split: ${sec.split_plan_top20}` : '';
    setTxt('imp-rate-note', `Highsec ${sec.warps || 35}w Tiered (<=1.5B: 52.5M DST / 87.5M Freighter)${splitNote}`);
    if (freightEl) freightEl.title = `All-Items Split (${sec.count} items): ${sec.split_plan_all || ''} (${fmtISK(sec.all_freight || 0)})`;
  } else {
    const colPct = ((Number(sec.collateral_pct) || 0) * 100).toFixed(1);
    const minNote = sec.min_freight > 0 ? ` | ${fmtISK(sec.min_freight)} Min / ${fmtISK(sec.max_freight)} Cap` : '';
    const trackNote = (isCj && sec.tracking_snapshots)
      ? ` | Burn Tracking: ${(Number(sec.tracking_days) || 0).toFixed(1)}d (${sec.tracking_snapshots} snaps, ${Math.round(Number(sec.tracking_confidence_pct) || 0)}% real)`
      : '';
    setTxt('imp-rate-note', `Courier: ${sec.freight_rate_m3} ISK/m³ | ${colPct}% Collateral${minNote}${trackNote}`);
    if (freightEl) freightEl.title = '';
  }

  const hideStocked = document.getElementById('imp-hide-stocked')?.checked ?? true;
  const rawItems = sec.items || [];
  const items = hideStocked ? rawItems.filter(r => (Number(r.suggested_qty) || 0) > 0) : rawItems;
  const tfoot = document.getElementById('imports-table-foot');
  if (!items.length) {
    tbody.innerHTML = '<tr><td colspan="12" class="p-6 text-center text-slate-500">All candidate items are already stocked or no profitable opportunities found. Uncheck "Hide Stocked" to inspect existing inventory.</td></tr>';
    if (tfoot) tfoot.innerHTML = '';
    return;
  }

  tbody.innerHTML = items.map((r, i) => {
    const st = String(r.status || 'ACTIVE');
    let badgeClass = 'bg-slate-800 text-slate-300 border-slate-700';
    if (st === 'FULLY_STOCKED') badgeClass = 'bg-emerald-950/80 text-emerald-300 border-emerald-600/80';
    else if (st === 'RESTOCK') badgeClass = 'bg-indigo-950/80 text-indigo-300 border-indigo-600/80';
    else if (st === 'LOW_STOCK') badgeClass = 'bg-amber-950/80 text-amber-300 border-amber-600/80';
    else if (st.startsWith('STOCKOUT')) badgeClass = 'bg-rose-950/80 text-rose-300 border-rose-600/80';
    else if (st === 'ACTIVE_BOOK' || st === 'UNDERCUT_LIST') badgeClass = 'bg-emerald-950/80 text-emerald-300 border-emerald-700/80';

    const qty = Number(r.suggested_qty) || 0;
    const targetQty = Number(r.target_qty) || qty;
    const localStock = Number(r.my_local_stock) || 0;
    const sellQty = Number(r.my_sell_qty) || 0;
    const hangarQty = Number(r.my_hangar_qty) || 0;
    const jitaQty = Number(r.my_jita_qty) || 0;
    const m3 = Number(r.m3) || 0;
    const jitaAsk = Number(r.jita_ask) || 0;
    const freightCost = Number(r.freight_cost) || 0;
    const suggSell = Number(r.suggested_sell) || 0;
    const marginPct = Number(r.margin_pct) || 0;
    const soloMarginPct = Number(r.solo_margin_pct) || marginPct;
    const iskPerM3 = Number(r.isk_per_m3) || 0;
    const estTotalProfit = Number(r.est_total_profit) || 0;

    const iskM3 = iskPerM3 >= 1e6 ? (iskPerM3 / 1e6).toFixed(1) + 'M' : Math.round(iskPerM3).toLocaleString();
    const volTip = r.vol_source && r.vol_source !== 'REGIONAL_30D'
      ? `title="C-J6MT Burn: ~${r.dest_daily_vol}/day [${r.vol_source}]${r.observed_daily_vol !== null && r.observed_daily_vol !== undefined ? ` (Observed: ${r.observed_daily_vol}/d)` : ''} | Jita: ${r.jita_vol_30d}/d | Shelf Depth: ${r.dest_sell_vol}"`
      : `title="Amarr 30d Daily Vol: ${r.dest_daily_vol}/day"`;

    return `
      <tr class="hover:bg-slate-800/40 transition" ${volTip}>
        <td class="p-3 text-slate-500">${i + 1}</td>
        <td class="p-3"><span class="border px-2 py-0.5 rounded text-[10px] font-bold ${badgeClass}">${st}</span></td>
        <td class="p-3 font-semibold text-white">
          <a href="https://evetycoon.com/market/${r.type_id}" target="_blank" class="hover:text-eveCyan hover:underline">${r.name}</a>
          <span class="text-[10px] text-slate-500 ml-1">(${r.group || ''})</span>
        </td>
        <td class="p-3 text-right font-semibold ${qty > 0 ? 'text-slate-200' : 'text-emerald-400'}">
          ${qty.toLocaleString()}
          ${localStock > 0 ? `<div class="text-[10px] text-slate-400 font-normal">of ${targetQty.toLocaleString()} target</div>` : ''}
        </td>
        <td class="p-3 text-right text-[11px]">
          ${localStock > 0
            ? `<span class="text-cyan-300 font-semibold">${localStock.toLocaleString()} on hand</span>
               <div class="text-[10px] text-slate-400">${[
                 sellQty > 0 ? `${sellQty} listed` : '',
                 hangarQty > 0 ? `${hangarQty} hangar` : '',
                 jitaQty > 0 ? `${jitaQty} Jita` : ''
               ].filter(Boolean).join(' · ')}</div>`
            : '<span class="text-slate-600">0</span>'}
        </td>
        <td class="p-3 text-right text-slate-400">${Math.round(m3 * qty).toLocaleString()}</td>
        <td class="p-3 text-right text-slate-300">${fmtISK(jitaAsk)}</td>
        <td class="p-3 text-right text-eveAmber/90">${fmtISK(freightCost)}</td>
        <td class="p-3 text-right text-white font-semibold">${fmtISK(suggSell)}</td>
        <td class="p-3 text-right text-eveCyan font-bold">${marginPct.toFixed(1)}% <span class="text-[10px] text-slate-500 font-normal">(${soloMarginPct.toFixed(1)}%)</span></td>
        <td class="p-3 text-right text-slate-300">${iskM3}</td>
        <td class="p-3 text-right text-eveGreen font-bold">+${fmtISK(estTotalProfit)}</td>
      </tr>`;
  }).join('');

  if (tfoot) {
    const totQty = items.reduce((s, r) => s + (Number(r.suggested_qty) || 0), 0);
    const totM3 = items.reduce((s, r) => s + ((Number(r.m3) || 0) * (Number(r.suggested_qty) || 0)), 0);
    const totJita = items.reduce((s, r) => s + ((Number(r.jita_ask) || 0) * (Number(r.suggested_qty) || 0)), 0);
    const totFreight = items.reduce((s, r) => s + ((Number(r.freight_cost) || 0) * (Number(r.suggested_qty) || 0)), 0);
    const totProf = items.reduce((s, r) => s + (Number(r.est_total_profit) || 0), 0);

    tfoot.innerHTML = `
      <tr>
        <td class="p-3 text-slate-400" colspan="3">TOTAL (${items.length} ITEMS)</td>
        <td class="p-3 text-right text-white">${totQty.toLocaleString()}</td>
        <td class="p-3"></td>
        <td class="p-3 text-right text-slate-300">${Math.round(totM3).toLocaleString()} m³</td>
        <td class="p-3 text-right text-eveCyan">${fmtISK(totJita)}</td>
        <td class="p-3 text-right text-eveAmber">${fmtISK(totFreight)}</td>
        <td class="p-3 text-right text-slate-500" colspan="3">Total Jita Buy &amp; Marginal Freight</td>
        <td class="p-3 text-right text-eveGreen">+${fmtISK(totProf)}</td>
      </tr>`;
  }
}

async function copyImportMultibuy(btn) {
  const sec = importData?.[currentImportDest];
  const actionable = (sec?.items || []).filter(r => (Number(r.suggested_qty) || 0) > 0).slice(0, 100);
  const text = actionable.length
    ? actionable.map(r => `${r.name} ${Number(r.suggested_qty)}`).join('\n')
    : (sec?.multibuy_text || '');
  if (!text) {
    alert('No MultiBuy items available to copy.');
    return;
  }
  const ok = await copyToClipboard(text);
  const orig = btn.innerText;
  btn.innerText = ok ? `Copied Top-${actionable.length || 100} MultiBuy!` : 'Copy Failed';
  setTimeout(() => { btn.innerText = orig; }, 2000);
}

let lastBundleData = null;

function toggleImportBundler() {
  const drawer = document.getElementById('import-bundler-drawer');
  if (drawer) drawer.classList.toggle('hidden');
}

async function runImportBundler(fromHangar = false) {
  const box = document.getElementById('imp-bundle-results');
  if (!box) return;
  box.innerHTML = '<div class="text-xs text-slate-400 p-4 text-center">Packing items into minimum-cost courier contracts...</div>';

  const rawText = fromHangar ? null : (document.getElementById('imp-bundle-paste')?.value || '');
  const rateOverride = currentImportDest === 'amarr'
    ? (parseInt(document.getElementById('imp-amarr-warps')?.value || '35', 10))
    : (parseFloat(document.getElementById('imp-cj6mt-rate')?.value || '800'));

  try {
    const res = await fetch('/api/import/bundles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        dest_key: currentImportDest,
        raw_text: rawText,
        from_jita_hangar: fromHangar,
        rate_override: rateOverride
      })
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    lastBundleData = data;

    if (!data.bundles || !data.bundles.length) {
      box.innerHTML = '<div class="text-xs text-slate-500 p-4 border border-dashed border-slate-800 rounded text-center">No matching purchased items found to bundle.</div>';
      return;
    }

    const headerHtml = `
      <div class="flex flex-wrap justify-between items-center bg-slate-900 border border-slate-700 px-3 py-2 rounded text-xs">
        <span class="font-bold text-white">${data.destination}: ${data.contract_count} Optimal Contract${data.contract_count > 1 ? 's' : ''}</span>
        <span class="text-slate-300">Total Vol: <strong>${Math.round(data.total_m3).toLocaleString()} m³</strong> | Collateral: <strong>${fmtISK(data.total_collateral)}</strong> | Total Reward: <strong class="text-eveAmber">${fmtISK(data.total_reward)}</strong></span>
      </div>`;

    const cardsHtml = data.bundles.map((b, idx) => `
      <div class="bg-slate-900/70 border border-slate-800 rounded p-2.5 space-y-1.5 text-xs">
        <div class="flex flex-wrap justify-between items-center gap-2">
          <div class="flex items-center gap-2">
            <span class="bg-indigo-950 text-indigo-300 border border-indigo-700 px-2 py-0.5 rounded font-bold">Contract #${b.bundle_num}</span>
            <span class="text-eveCyan font-bold">${b.tier}</span>
            <span class="text-slate-400">${Math.round(b.total_m3).toLocaleString()} m³ | Col: ${fmtISK(b.collateral)} | Reward: <strong class="text-eveAmber">${fmtISK(b.reward)}</strong></span>
          </div>
          <button onclick="copySingleBundle(${idx}, this)" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 px-2 py-0.5 rounded text-[11px] transition">
            Copy Items
          </button>
        </div>
        <div class="text-[11px] text-slate-300 pl-1">
          ${b.items.map(it => `<span class="inline-block mr-3">${it.qty.toLocaleString()}x <strong class="text-white">${it.name}</strong> <span class="text-slate-500">(${fmtISK(it.collateral)})</span></span>`).join('')}
        </div>
      </div>`).join('');

    box.innerHTML = headerHtml + cardsHtml;
  } catch (err) {
    box.innerHTML = `<div class="text-xs text-rose-400 p-4 text-center">Bundler error: ${err.message}</div>`;
  }
}

async function copySingleBundle(idx, btn) {
  const b = lastBundleData?.bundles?.[idx];
  if (!b || !b.copy_text) return;
  const ok = await copyToClipboard(b.copy_text);
  const orig = btn.innerText;
  btn.innerText = ok ? 'Copied!' : 'Failed';
  setTimeout(() => { btn.innerText = orig; }, 1500);
}

async function checkCj6mtSellerStock() {
  const drawer = document.getElementById('cj6mt-stock-drawer');
  const tbody = document.getElementById('cj6mt-stock-body');
  const summary = document.getElementById('cj6mt-stock-summary');
  const title = document.getElementById('cj6mt-stock-title');
  if (!drawer || !tbody) return;

  drawer.classList.remove('hidden');
  tbody.innerHTML = '<tr><td colspan="8" class="p-4 text-center text-slate-400">Querying C-J6MT Keepstar hangar & active sell orders...</td></tr>';

  try {
    const res = await fetch('/api/import/cj6mt-stock');
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();

    title.innerText = `C-J6MT Seller Stock Audit — ${data.character_name} (1st Taj Mahgoon)`;
    const warnTxt = data.structure_warning ? ` | Warning: ${data.structure_warning}` : '';
    summary.innerText = `Hangar Units: ${data.total_hangar_units.toLocaleString()} (${fmtISK(data.est_hangar_value)}) | Active Sell Units: ${data.total_listed_units.toLocaleString()} (${fmtISK(data.est_shelf_value)})${warnTxt}`;

    const items = data.items || [];
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="p-4 text-center text-slate-500">No hangar stock or active sell orders found in C-J6MT for this character.</td></tr>';
      return;
    }

    tbody.innerHTML = items.map(r => {
      let badge = 'bg-slate-800 text-slate-300 border-slate-700';
      if (r.status === 'UNLISTED_HANGAR') badge = 'bg-amber-950/80 text-amber-300 border-amber-600/80';
      else if (r.status === 'UNDERCUT') badge = 'bg-rose-950/80 text-rose-300 border-rose-600/80';
      else if (r.status === 'TOP_ASK' || r.status === 'ACTIVE + RESERVE') badge = 'bg-emerald-950/80 text-emerald-300 border-emerald-700/80';

      return `
        <tr class="hover:bg-slate-800/40">
          <td class="p-2"><span class="border px-1.5 py-0.5 rounded text-[10px] font-bold ${badge}">${r.status}</span></td>
          <td class="p-2 font-semibold text-white">${r.name} <span class="text-[10px] text-slate-500">(${r.group})</span></td>
          <td class="p-2 text-right text-amber-300 font-semibold">${r.hangar_qty.toLocaleString()}</td>
          <td class="p-2 text-right text-emerald-300 font-semibold">${r.sell_qty.toLocaleString()}</td>
          <td class="p-2 text-right text-slate-300">${r.my_sell_price ? fmtISK(r.my_sell_price) : '--'}</td>
          <td class="p-2 text-right text-slate-300">${r.structure_lowest_ask ? fmtISK(r.structure_lowest_ask) : 'NONE'}</td>
          <td class="p-2 text-right text-white font-semibold">${r.recommended_sell ? fmtISK(r.recommended_sell) : '--'}</td>
          <td class="p-2 text-right text-eveCyan font-bold">${fmtISK(r.est_total_value)}</td>
        </tr>`;
    }).join('');
  } catch (err) {
    tbody.innerHTML = `<tr><td colspan="8" class="p-4 text-center text-rose-400">Stock audit failed: ${err.message}</td></tr>`;
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const params = new URLSearchParams(window.location.search);
  if (params.get('tab') === 'imports' && typeof switchTab === 'function') {
    switchTab('imports');
  }
});
